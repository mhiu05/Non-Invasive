dup 112 /p put
dup 40 /parenleft put
dup 41 /parenright put
dup 43 /plus put
dup 59 /semicolon put
dup 116 /t put
dup 50 /two put
dup 120 /x put
readonly def
currentdict end
currentfile eexec
