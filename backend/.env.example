APP_NAME="Non-Invasive Health API"
DEBUG=false

# Model
MODEL_PATH=weights/UBFC-rPPG_FactorizePhys_FSAM_Res.onnx
MODEL_CONFIG_PATH=weights/model_config.json
DEVICE=cpu

# Signal processing
FPS=30
BUFFER_SIZE=180
HR_LOW_HZ=0.75
HR_HIGH_HZ=2.5

# Upload
MAX_UPLOAD_MB=100

# Chatbot (RAG)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="<your_gemini_api_key_here>"
CHATBOT_MODEL="gemini-1.5-flash-latest"
CHATBOT_MODEL_FALLBACK="gemini-1.5-pro-latest"
VECTORSTORE_PATH=vectorstore/faiss_index

# Supabase (Database & Auth)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
SUPABASE_DB_URL="<your_supabase_postgresql_connection_string>"

# Get from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="<your_supabase_project_url>"
SUPABASE_ANON_KEY="<your_supabase_anon_public_key>"
SUPABASE_SERVICE_KEY="<your_supabase_service_role_key>"
SUPABASE_JWT_SECRET="<your_supabase_jwt_secret>"

# Redis & Celery
# If using Docker Compose, keep this as redis://redis:6379/0
REDIS_URL="redis://redis:6379/0"

# Object Storage (Supabase S3 Compatible)
# Get from: Supabase Dashboard -> Project Settings -> Storage -> S3 Connection
STORAGE_ENDPOINT="<your_supabase_s3_endpoint_url>"
STORAGE_KEY="<your_supabase_s3_access_key>"
STORAGE_SECRET="<your_supabase_s3_secret_key>"
STORAGE_BUCKET="videos"
