# Backend environment variables for Non-Invasive Health API
# Copy this file to .env and customize values as needed.

APP_NAME="Non-Invasive Health API"
DEBUG=false

# Model configuration
MODEL_PATH=weights/PURE_DeepPhys.onnx
MODEL_CONFIG_PATH=weights/model_config.json
DEVICE=cpu

# Signal processing
FPS=30
BUFFER_SIZE=180
HR_LOW_HZ=0.75
HR_HIGH_HZ=2.5
BLINK_LOW_HZ=0.1
BLINK_HIGH_HZ=0.9

# Upload limits
MAX_UPLOAD_MB=100

# Chatbot (RAG) — requires Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
CHATBOT_MODEL=gemini-2.5-flash
VECTORSTORE_PATH=vectorstore/faiss_index
